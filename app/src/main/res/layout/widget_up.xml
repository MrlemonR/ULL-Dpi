<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="ULL::DPI"
            android:textColor="#F0F0F0"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="○ KAPALI"
            android:textColor="#8C8C8C"
            android:textSize="9sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_up"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="56sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/doto"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFFFFF" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="↑ YÜKLEME · Mbps"
        android:textColor="#B8B8B8"
        android:textSize="10sp" />
    <TextView
        android:id="@+id/w_ping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="PING — ms"
        android:textColor="#8C8C8C"
        android:textSize="9sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" />
    <TextView
        android:id="@+id/w_btn"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_btn_off"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="[ BAŞLAT ]"
        android:textColor="#F0F0F0"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
